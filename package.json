{
	"name": "funkonation",
	"version": "1.0.0",
	"description": "Rsbuild Module Federation example with Zephyr",
	"private": true,
	"scripts": {
		"build": "pnpm build-providers && pnpm build-consumers",
		"build-providers": "pnpm -r --filter=./providers/* build",
		"build-consumers": "pnpm -r --filter=./consumers/* build",
		"dev": "pnpm -r --filter=./providers/* dev & pnpm -r --filter=./consumers/* dev",
		"lint": "biome check --write"
	},
	"keywords": [
		"rsbuild",
		"module-federation",
		"zephyr"
	],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@biomejs/biome": "2.4.7"
	}
}
